{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo; the
    password-toggle stylesheet is the PasswordToggle bundle's own shipped asset. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Console Debug',
    home_route: 'homepage',
    repository: 'https://github.com/nowo-tech/ConsoleDebugBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'homepage'},
        {label: 'Examples', route: 'demo_debug'},
    ],
    auth: {login_route: 'login', logout_route: 'logout'},
} %}
{% block nowo_ui_document_title %}{% block title %}Console Debug Demo{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowopasswordtoggle/css/toggle_password.css') }}">
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
{% endblock %}
